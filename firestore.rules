rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check if user owns the document
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // Two helpers used to live here that read studentIds / adminClassIds from
    // the *caller's own* user document. Because a user can write that document,
    // any authenticated account could grant itself read, update and delete on
    // every student, homework and attendance record in any class. They existed
    // only as a fallback for legacy documents missing parentUserIds /
    // invitedTeacherIds; an audit of production found zero such documents, so
    // they were removed rather than made symmetric.
    //
    // The rule worth keeping: never decide access from a document the caller
    // can write. Every check below reads the document being accessed.

    // Owner + accepted co-teachers, denormalized onto the class document by
    // the syncClassAdminUserIds Cloud Function. Read from the class itself, so
    // it cannot be self-granted.
    function isClassMember(classData) {
      return classData.keys().hasAll(['adminUserIds'])
        && request.auth.uid in classData.adminUserIds;
    }

    // The caller's verified email, lowercased, or '' when unverified.
    // Invites are addressed by email, so this is what proves an invite is
    // yours. Unverified is deliberately '' rather than the claimed address:
    // Firebase will mint an account for any address you type, so an
    // unverified token says nothing about who you are. Same reasoning as the
    // email_verified check in acceptParentInvites.
    function verifiedEmail() {
      return request.auth.token.email_verified == true
        ? request.auth.token.email.lower()
        : '';
    }

    // May the caller act on this student? Reads the student document, never
    // anything the caller can write. Used to stop forged invites: an invite
    // naming a child you have no relationship with is how an attacker gets
    // themselves linked to that child.
    function canManageStudent(studentId) {
      return exists(/databases/$(database)/documents/students/$(studentId))
        && (
          get(/databases/$(database)/documents/students/$(studentId)).data.teacherId == request.auth.uid
          || request.auth.uid in get(/databases/$(database)/documents/students/$(studentId)).data.invitedTeacherIds
        );
    }

    // May the caller add a co-teacher to this class? Owner or existing member.
    function canManageClass(classId) {
      return exists(/databases/$(database)/documents/classes/$(classId))
        && (
          get(/databases/$(database)/documents/classes/$(classId)).data.teacherId == request.auth.uid
          || isClassMember(get(/databases/$(database)/documents/classes/$(classId)).data)
        );
    }

    // Derived teacher access: is the caller on this class?
    //
    // Reads the class document rather than a copy stamped on each record. For
    // a class-scoped query Firestore evaluates this once and caches it, so the
    // whole query costs ONE document read against a limit of ten — which holds
    // only while queries stay class-scoped. All 15 teacher queries are.
    //
    // This runs alongside isInInvitedTeacherIds() during the migration: a
    // record satisfying either is readable, so installed builds keep working
    // while new ones stop relying on the array. The array goes in phase 4.
    function isClassMemberOf(classId) {
      return classId is string
        && exists(/databases/$(database)/documents/classes/$(classId))
        && (
          get(/databases/$(database)/documents/classes/$(classId)).data.teacherId == request.auth.uid
          || isClassMember(get(/databases/$(database)/documents/classes/$(classId)).data)
        );
    }

    // Field-based: user's uid is in parentUserIds array on the document
    function isInParentUserIds(data) {
      return data.keys().hasAll(['parentUserIds']) && request.auth.uid in data.parentUserIds;
    }

    // Field-based: user's uid is in invitedTeacherIds array on the document
    function isInInvitedTeacherIds(data) {
      return data.keys().hasAll(['invitedTeacherIds']) && request.auth.uid in data.invitedTeacherIds;
    }

    // Remote app config: the minimum supported app version and store links.
    //
    // Readable WITHOUT signing in, on purpose — the version gate runs before
    // authentication so an unsupported build is stopped at the login screen.
    // It holds no user data. Writes are Admin SDK / console only, so a client
    // cannot lift its own restriction.
    match /config/{document} {
      allow read: if true;
      allow write: if false;
    }

    // Organizations. Created and staffed from ilmtrack-admin (Admin SDK), so
    // no client writes them. Readable only by the people who administer one:
    // memberUserIds is on the document being read and derived by the console
    // from `members` in the same write, so it cannot be self-granted.
    //
    // Teaching in an organization (owning or co-teaching one of its classes)
    // deliberately grants nothing here.
    match /organizations/{orgId} {
      allow read: if isAuthenticated()
        && resource.data.keys().hasAll(['memberUserIds'])
        && request.auth.uid in resource.data.memberUserIds;
      allow write: if false;
    }

    // Does the caller administer this organization? Read from the
    // organization document, which only ilmtrack-admin writes. For a query
    // scoped to one orgId this costs one cached read.
    function isOrgAdmin(orgId) {
      return orgId is string
        && exists(/databases/$(database)/documents/organizations/$(orgId))
        && request.auth.uid in
           get(/databases/$(database)/documents/organizations/$(orgId)).data.memberUserIds;
    }

    // Timekeeping settings: timekeeping/{orgId}. Locations and the on/off
    // switch, managed by the organization's admins.
    match /timekeeping/{orgId} {
      allow read: if isAuthenticated() && isOrgAdmin(orgId);
      allow create, update: if isAuthenticated()
        && isOrgAdmin(orgId)
        && request.resource.data.orgId == orgId;
      allow delete: if false;
    }

    // One teacher's shifts for one week: schedules/{orgId}_{teacherId}_{weekStart}.
    //
    // The id is checked against the fields on every write, so a document
    // cannot claim one organization in its id and another in its data. That
    // also lets a read of a week that does not exist yet (every transaction
    // starts with one) be authorized from the id alone. Organization ids are
    // Firestore auto-ids and uids are alphanumeric, so neither contains '_'.
    //
    // Not checked here: that the teacher actually teaches in the organization.
    // Rules cannot query classes. The Cloud Function that starts a shift
    // checks it, which is where it matters.
    match /schedules/{scheduleId} {
      function idOrg() { return scheduleId.split('_')[0]; }
      function idTeacher() { return scheduleId.split('_')[1]; }

      function validSchedule(data) {
        return scheduleId == data.orgId + '_' + data.teacherId + '_' + data.weekStart
          && data.weekStart.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && data.shifts is list
          && data.shifts.size() <= 50;
      }

      allow read: if isAuthenticated() && (
        resource == null
          ? (idTeacher() == request.auth.uid || isOrgAdmin(idOrg()))
          : (resource.data.teacherId == request.auth.uid || isOrgAdmin(resource.data.orgId))
      );
      allow create: if isAuthenticated()
        && isOrgAdmin(request.resource.data.orgId)
        && validSchedule(request.resource.data);
      // The id check pins orgId, teacherId and weekStart, so none can change.
      allow update: if isAuthenticated()
        && isOrgAdmin(resource.data.orgId)
        && validSchedule(request.resource.data);
      allow delete: if isAuthenticated() && isOrgAdmin(resource.data.orgId);
    }

    // Users collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isOwner(userId);

      // Still open to any authenticated caller, because three client-side
      // writes target *other people's* user documents and would break in every
      // installed build: adminClassIds on an invited co-teacher
      // (class.service.ts), the same on removal, and studentIds on a parent
      // (student.service.ts). Those arrays grant nothing any more — no rule
      // reads them — so they are UI hints and the cross-user writes are
      // harmless.
      //
      // `role` is the exception and is frozen. ilmtrack-admin's resolveRole()
      // trusts users/{uid}.role == 'teacher' to grant console access, so a
      // writable role is the same self-attesting pattern that the removed
      // isAdminOfClass()/isLinkedParent() helpers were. Nothing legitimate
      // writes it after signup: it is set once by setDoc at account creation,
      // and updateUserProfile only touches firstName/lastName.
      //
      // Tested via affectedKeys() rather than comparing values, so adding or
      // removing the field is caught too, not just changing it.
      //
      // The `resource == null` arm matters: for a document that does not exist
      // `resource.data` cannot be dereferenced, so without it an update to a
      // deleted user's doc fails as permission-denied instead of not-found.
      // parentLinkCleanup hits exactly that when a parent's account has been
      // deleted, and since #2 now treats permission-denied as fatal it would
      // abort the whole cleanup. Allowing the rule through here changes
      // nothing: Firestore still rejects the write as not-found.
      allow update: if isAuthenticated() && (
        resource == null
        || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role'])
      );

      allow delete: if isAuthenticated() && isOwner(userId);
    }

    // Classes collection
    // A class's organization is assigned by ilmtrack-admin (Admin SDK) only.
    // Classes are readable by everyone signed in, so organization ids are not
    // secret; without this, anyone could attach their class to an organization
    // and join its teacher roster, or detach a class from one. Nothing in the
    // app writes orgId. Compared with get() so adding, changing and removing
    // the field are all caught.
    function orgIdUnchanged() {
      return request.resource.data.get('orgId', null) == resource.data.get('orgId', null);
    }

    match /classes/{classId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() &&
        request.resource.data.teacherId == request.auth.uid &&
        !request.resource.data.keys().hasAny(['orgId']);
      // A co-teacher may edit the class (name, studentCount, ...) but may not
      // change who owns it or who administers it. That belongs to the owner,
      // and it is what stopped the old escalation from becoming permanent.
      // Neither may change its organization.
      allow update: if isAuthenticated() && orgIdUnchanged() && (
        resource.data.teacherId == request.auth.uid ||
        (
          isClassMember(resource.data) &&
          request.resource.data.teacherId == resource.data.teacherId &&
          request.resource.data.admins == resource.data.admins &&
          request.resource.data.adminUserIds == resource.data.adminUserIds
        )
      );
      allow delete: if isAuthenticated() &&
        resource.data.teacherId == request.auth.uid;
    }

    // Students collection
    match /students/{studentId} {
      allow read: if isAuthenticated() && (
        resource.data.teacherId == request.auth.uid ||
        isInParentUserIds(resource.data) ||
        isInInvitedTeacherIds(resource.data)
        || isClassMemberOf(resource.data.classId)
      );
      allow create: if isAuthenticated() && (
        request.resource.data.teacherId == request.auth.uid ||
        isInInvitedTeacherIds(request.resource.data)
      );
      allow update, delete: if isAuthenticated() && (
        resource.data.teacherId == request.auth.uid ||
        isInInvitedTeacherIds(resource.data)
      );
    }

    // Homework collection
    match /homework/{homeworkId} {
      allow read: if isAuthenticated() && (
        resource.data.teacherId == request.auth.uid ||
        isInParentUserIds(resource.data) ||
        isInInvitedTeacherIds(resource.data)
        || isClassMemberOf(resource.data.classId)
      );
      allow create: if isAuthenticated() && (
        request.resource.data.teacherId == request.auth.uid ||
        isInInvitedTeacherIds(request.resource.data)
      );
      allow update, delete: if isAuthenticated() && (
        resource.data.teacherId == request.auth.uid ||
        isInInvitedTeacherIds(resource.data)
      );
    }

    // Attendance collection
    match /attendance/{attendanceId} {
      allow read: if isAuthenticated() && (
        resource.data.teacherId == request.auth.uid ||
        isInParentUserIds(resource.data) ||
        isInInvitedTeacherIds(resource.data)
        || isClassMemberOf(resource.data.classId)
      );
      allow create: if isAuthenticated() && (
        request.resource.data.teacherId == request.auth.uid ||
        isInInvitedTeacherIds(request.resource.data)
      );
      allow update, delete: if isAuthenticated() && (
        resource.data.teacherId == request.auth.uid ||
        isInInvitedTeacherIds(resource.data)
      );
    }

    // Invites collection - for parent invitation tracking
    // Class membership, replacing students.classId.
    //
    // Written only by the Admin SDK — the migration script, the bridge
    // trigger, and the app's own writes go through Cloud Functions — so
    // clients never create or change one. That keeps the collection that now
    // decides who is in a class out of reach of the people it governs.
    match /enrollments/{enrollmentId} {
      allow read: if isAuthenticated() && (
        isClassMemberOf(resource.data.classId)
        // A parent reads their own children's enrolments, which costs one
        // document read per child; their queries are scoped to their own.
        || (
          exists(/databases/$(database)/documents/students/$(resource.data.studentId))
          && request.auth.uid in
             get(/databases/$(database)/documents/students/$(resource.data.studentId)).data.parentUserIds
        )
      );
      allow create, update, delete: if false;
    }

    // Parent invites. acceptParentInvites() links a caller to every student
    // named by an invite carrying their verified email, so whoever can write
    // these documents decides who sees which child.
    match /invites/{inviteId} {
      allow read: if isAuthenticated();

      // Create only for a student you already teach. Without this, forging an
      // invite with your own address and someone else's studentId is enough
      // to have acceptParentInvites link you to that child.
      //
      // Deliberately not also requiring teacherId == request.auth.uid: the
      // transfer flow in student.service.ts copies the *owner's* id onto the
      // invite even when a co-teacher performs the transfer, and that check
      // would silently break it. canManageStudent already proves the caller
      // has a relationship with the child, which is the thing that matters.
      allow create: if isAuthenticated()
        && canManageStudent(request.resource.data.studentId);

      // No client updates these: the app only creates and deletes them, and
      // acceptParentInvites runs on the Admin SDK, which ignores rules. The
      // onInviteAccepted trigger has no request.auth and so cannot check a
      // caller itself — flipping status to 'accepted' was the whole exploit.
      allow update: if false;

      // Deleting an invite only withdraws access, so it stays open to the
      // teacher doing parent cleanup, whose student may already be gone.
      allow delete: if isAuthenticated();
    }

    // Teacher invites collection - for shared class access tracking
    // Co-teacher invites. Accepting one grants access to a whole class, via
    // the onTeacherInviteAccepted trigger — which, being a trigger, has no
    // caller to verify. The gate has to be here.
    match /adminInvites/{inviteId} {
      allow read: if isAuthenticated();

      // Only someone already on the class may invite to it.
      allow create: if isAuthenticated()
        && canManageClass(request.resource.data.classId);

      // Accepting your own invite, and only your own. Both halves matter:
      // the email check stops you accepting an invite addressed to someone
      // else, and the userId check stops you accepting one on their behalf
      // and pointing it at yourself. Matches what AuthContext already sends.
      allow update: if isAuthenticated()
        && verifiedEmail() != ''
        && resource.data.email.lower() == verifiedEmail()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.email == resource.data.email
        && request.resource.data.classId == resource.data.classId;

      allow delete: if isAuthenticated();
    }
  }
}
